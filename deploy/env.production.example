# Production .env template for the Leasyback backend.
# provision.sh copies this to <APP_DIR>/.env on first run. Fill in every value
# marked CHANGE_ME before the first deploy, then run: php artisan key:generate

APP_NAME=Leasyback
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://leasyback.insuretechgurus.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite. provision.sh creates this file (owner deploy, group www-data, 0664)
# and keeps the database/ directory group-writable for the -wal/-shm siblings.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/LeasyBack/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=leasyback.insuretechgurus.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
# S3 holds vehicle photos and DEKRA documents. Set FILESYSTEM_DISK=public
# instead if you want uploads on the Linode disk (then run storage:link).
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

# Switch CACHE_STORE/QUEUE_CONNECTION/SESSION_DRIVER to redis once traffic
# grows; redis-server is installed and running by provision.sh.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=sendgrid
MAIL_FROM_ADDRESS="service@leasyback.com"
MAIL_FROM_NAME="Leasyback"
SENDGRID_API_KEY=CHANGE_ME

AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=CHANGE_ME
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bootstrap Admin account. Required before running deploy.sh --seed; seeding
# aborts if ADMIN_SEED_PASSWORD is empty. Change the password after first login.
ADMIN_SEED_NAME="Leasyback Admin"
ADMIN_SEED_EMAIL=admin@leasyback.com
ADMIN_SEED_PASSWORD=CHANGE_ME

FRONTEND_URL=https://leasyback.insuretechgurus.com
SANCTUM_STATEFUL_DOMAINS=leasyback.insuretechgurus.com

VITE_APP_NAME="${APP_NAME}"

# DEKRA Process Integration — swap to the production endpoint when go-live.
DEKRA_USERNAME=CHANGE_ME
DEKRA_PASSWORD=CHANGE_ME
DEKRA_API_URL=https://ws-auth-test.dekra.com/X4/httpstarter/ReST/internal/order
DEKRA_TIMEOUT=30
DEKRA_CONNECT_TIMEOUT=10

S3_BUCKET_NAME="${AWS_BUCKET}"

VITE_GOOGLE_PLACES_API_KEY=CHANGE_ME

# Reverb — generate fresh production credentials, do not reuse the local ones:
#   php artisan reverb:install  (or any random 32-char hex values)
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
# Public host/scheme the browser connects to (through nginx, TLS on 443).
REVERB_HOST=leasyback.insuretechgurus.com
REVERB_PORT=443
REVERB_SCHEME=https
# Local bind — nginx proxies to this. Must match deploy/config.sh REVERB_PORT.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Web push — generate once with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"
