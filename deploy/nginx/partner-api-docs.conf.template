# Managed by deploy/provision.sh — placeholders are substituted at install time.
# Installed to /etc/nginx/snippets/leasyback-partner-api-docs.conf and pulled
# into the leasyback server block by an `include`.
#
# Serves the bundle written by `php artisan partner:docs` at
# https://__DOMAIN__/api-docs, behind HTTP Basic Auth.
#
# The bundle stays where it is generated, under storage/app/private. nginx reads
# it through `alias`; nothing is copied into public/, and no Laravel route,
# session or database row is involved on this path. The internal preview at
# /partner-api/docs is unaffected and still runs through
# PartnerApiDocsController behind ['auth','active','verified','admin'].
#
# The Basic Auth credential here is for a *human* opening the documentation in a
# browser. It is not the Partner API Bearer token (software), and not the webhook
# signing secret (also software). All three are separate and are issued and
# rotated separately — see docs/partner-api/DEPLOYMENT.md §4a.

# Scribe's static bundle links its assets relatively (`./css/…`, `./images/…`,
# `./openapi.yaml`) and a browser resolves those against the *parent* of the
# current path. Without a trailing slash that parent is `/`, so every asset would
# be fetched from the site root and 404. This redirect is what makes /api-docs
# work when somebody types it.
location = /api-docs {
    return 301 /api-docs/;
}

# The trailing slash on BOTH the location prefix and the alias is load-bearing.
# `location /api-docs { alias …/partner-api-docs/; }` — prefix without a slash,
# alias with one — is the classic nginx alias traversal: a request for
# `/api-docs../` concatenates to a path outside the docs root. Matching slash to
# slash is the fix, not a style choice.
#
# `^~` stops nginx from considering the regex locations for anything under this
# prefix, most importantly `location ~ \.php$`. The generator writes no .php file
# into the bundle; this makes it structurally impossible for one to be executed
# if that ever changes.
location ^~ /api-docs/ {
    alias __APP_DIR__/storage/app/private/partner-api-docs/;

    auth_basic           "LeasyBack Partner API documentation";
    auth_basic_user_file /etc/nginx/.partner-docs-users;

    # nginx decodes %-escapes and collapses `..` while normalising the request
    # URI, before it picks a location. `/api-docs/../../.env` is normalised to
    # `/.env` and never enters this block, so there is no path to re-check here.
    # `index` resolves the directory root to index.html; nested asset paths
    # (css/, js/, images/) fall through to the static file handler unchanged.
    index index.html;
    autoindex off;

    # Regenerated by `partner:docs` on demand — a cached copy is a stale
    # contract. Same header the internal preview controller sends.
    add_header Cache-Control "private, no-store, max-age=0" always;

    # add_header in a location *replaces* the server-level set rather than
    # adding to it, so the server's three security headers are repeated here.
    # nosniff is the one that matters most on a path serving mixed static types.
    add_header X-Frame-Options        "SAMEORIGIN"                     always;
    add_header X-Content-Type-Options "nosniff"                        always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # Its own log, so partner reads are auditable without grepping them out of
    # the application's traffic.
    access_log /var/log/nginx/leasyback-partner-docs-access.log;

    # `^~` above means the server-level dotfile deny no longer applies here.
    location ~ /\. {
        deny all;
    }
}

# `.yaml` is not in nginx's default mime.types, so openapi.yaml would go out as
# application/octet-stream and download instead of rendering — and any tooling
# the partner points at the URL would have to guess. An exact-match location
# wins over the `^~` prefix above, so this is the one file whose type is set by
# hand. (.json, .css, .js, .svg and .png are all in mime.types already.)
location = /api-docs/openapi.yaml {
    alias __APP_DIR__/storage/app/private/partner-api-docs/openapi.yaml;

    auth_basic           "LeasyBack Partner API documentation";
    auth_basic_user_file /etc/nginx/.partner-docs-users;

    default_type application/yaml;

    add_header Cache-Control          "private, no-store, max-age=0" always;
    add_header X-Content-Type-Options "nosniff"                      always;

    access_log /var/log/nginx/leasyback-partner-docs-access.log;
}
