APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SendGrid via SMTP relay. MAIL_USERNAME is the SendGrid-mandated literal
# "apikey"; MAIL_PASSWORD is the API key itself (never commit a real value).
# Locally you can keep MAIL_MAILER=log and read storage/logs/laravel.log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="service@leasyback.com"
MAIL_FROM_NAME="LeasyBack"

# Alternative to the block above: MAIL_MAILER=sendgrid uses the dedicated
# mailer in config/mail.php with its own key variable.
SENDGRID_API_KEY=

# Comma-separated internal recipients for staff-facing emails (new order
# created). Empty means those emails are skipped and logged, never sent to a
# hardcoded address. OPS_NOTIFICATION_EMAIL is the legacy single-value form.
ADMIN_NOTIFICATION_EMAILS=
OPS_NOTIFICATION_EMAIL=

# Customer call-to-action links. MAIL_PORTAL_URL defaults to FRONTEND_URL.
# {vehicle} is replaced with the vehicle id.
MAIL_PORTAL_URL=
MAIL_PORTAL_DASHBOARD_PATH=/dashboard
MAIL_PORTAL_B2C_VEHICLE_PATH=/vehicles/{vehicle}
MAIL_PORTAL_B2B_VEHICLE_PATH=/vehicles/{vehicle}

# Email branding and support block (see config/mail_notifications.php).
# MAIL_LOGO_URL is only needed to override the bundled white-on-dark logo
# (public/leasyback-stacked.png) with a CDN-hosted asset.
MAIL_LOGO_URL=
MAIL_COMPANY_NAME="LeasyBack GmbH"
MAIL_COMPANY_ADDRESS="Rolshover Str. 45, 51105 Köln, NRW, Deutschland"
MAIL_COMPANY_WEBSITE_URL=https://www.leasyback.com
MAIL_SUPPORT_EMAIL=office@leasyback.com
MAIL_SUPPORT_PHONE="0221 88750755"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bootstrap Admin account created by `php artisan db:seed`. Locally the
# password may be left empty (it then falls back to 12345678); in production
# ADMIN_SEED_PASSWORD is required and seeding aborts without it.
ADMIN_SEED_NAME="Leasyback Admin"
ADMIN_SEED_EMAIL=admin@leasyback.com
ADMIN_SEED_PASSWORD=

FRONTEND_URL=https://app.leasyback.com

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173,app.leasyback.com

VITE_APP_NAME="${APP_NAME}"

# DEKRA Process Integration
DEKRA_USERNAME=
DEKRA_PASSWORD=
DEKRA_API_URL=https://ws-auth-test.dekra.com/X4/httpstarter/ReST/internal/order
DEKRA_TIMEOUT=30
DEKRA_CONNECT_TIMEOUT=10

# TUV SUD Integration. Credentials are issued by TUV SUD (Autoservice-Portal);
# there is no separate test host, so TUVSUD_URL is the live endpoint for both
# sandbox and production accounts - only the credentials differ.
TUVSUD_URL=https://mobility.autoservice-portal.de/api/rest/auftraege/beauftragung
TUVSUD_USER_NAME=leasyback_order
TUVSUD_TOKEN=44taLFNzZ85trDyABSXM
TUVSUD_PRODUCT_KEY=LEASYBACK
TUVSUD_PARTNER_NUMBER=4711
# Shared secret we choose for TUV SUD's inbound callbacks
# (order/tuvsud/confirm, order/tuvsud/status). VerifyTuvsudApiKey fails
# closed with 503 when this is unset - never commit a real value here.
TUVSUD_API_KEY=AKIAZI2PK2IT5KC3EZBV

# Legacy dekra_process variable; AWS_BUCKET takes precedence.
S3_BUCKET_NAME=

VITE_GOOGLE_PLACES_API_KEY=

REVERB_APP_ID=795274
REVERB_APP_KEY=3825b8d7a31c24f2320160ce3cffbb1b
REVERB_APP_SECRET=8cbe5d078d8c947b8f466ddfe4b02530
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"
